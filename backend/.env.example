# MotionLab Backend — Environment Variables
# Copy this file to .env and fill in values for your environment.
# Do NOT commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (MVP)
# Production: postgresql://user:password@host:5432/motionlab
DATABASE_URL=sqlite:///./motionlab.db

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development            # development | production
APP_PORT=8000
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production
ALLOWED_ORIGINS=http://localhost:5173

# ── Data Collection (opt-in) ──────────────────────────────────────────────────
# Directory where anonymized landmark sequences are saved (if user opts in)
DATA_DIR=./data
